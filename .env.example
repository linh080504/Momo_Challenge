# Sao chép thành .env và điền giá trị. KHÔNG commit .env.
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
# Analyzer (apps/api/app/analyzer — ai-engineer). Nha cung cap LLM: none (mac dinh = che do han che,
# chi dung luat + danh sach den) | mock (offline, de tich hop BE/FE) | <ten nha cung cap>.
# LLM_FALLBACK_PROVIDER de trong = dung chung nha cung cap chinh.
LLM_PROVIDER=
LLM_FALLBACK_PROVIDER=
# Thu muc chua prompts/analyzer_v*.md. De trong = tu tim thu muc prompts/ o goc repo.
# BAT BUOC dat khi image deploy khong co thu muc prompts/ o cung cay thu muc voi analyzer.
PROMPTS_DIR=
SAFE_BROWSING_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ANALYZER_URL=http://localhost:8000

# API (apps/api) — xem docs/RUN_LOCAL.md. De trong = dung mac dinh trong code.
# Origin duoc phep goi API, cach nhau bang dau phay. Local: web o localhost:3000.
# Khi deploy: dat thanh URL web that, vi du https://ten-mien-cua-doi.vn
ALLOWED_ORIGINS=http://localhost:3000
# Mac dinh SQLite o apps/api/data/tkc.db. Doi sang Postgres/Supabase chi bang bien nay
# (cai them driver Postgres), vi du postgresql://user:password@host:5432/dbname
DATABASE_URL=
# BAT BUOC. Khoa HMAC-SHA256 de bam SDT/STK/ten mien truoc khi luu va tra danh sach den (>= 32 ky tu).
# Tao: py -3 -c "import secrets; print(secrets.token_hex(32))"  — dan ket qua vao day, trong .env that.
# KHONG commit gia tri that. DOI KHOA = moi hash cu mat tac dung (khong bam lai duoc), nen chon mot lan,
# luu trong secret cua nha cung cap va sao luu rieng. API khong khoi dong neu thieu khoa.
ENTITY_HASH_KEY=
# Version tra ve o GET /health. Khi deploy dat = git sha (hoac dat GIT_SHA).
APP_VERSION=
GIT_SHA=
ANALYZE_TIMEOUT_SECONDS=25
# Rate limit theo IP, so request moi 60 giay.
RATE_LIMIT_ANALYZE_PER_MIN=20
RATE_LIMIT_REPORTS_PER_MIN=10
RATE_LIMIT_DEFAULT_PER_MIN=60
# So proxy tin cay dung truoc API (Cloud Run/Railway/Fly = 1). De 0 khi chay truc tiep:
# luc do bo qua X-Forwarded-For (neu tin nham, ai cung gia IP de ne rate limit).
TRUSTED_PROXY_COUNT=0
# Chi can khi image deploy khong co thu muc .claude/ day du:
ANALYSIS_SCHEMA_PATH=
VIETQR_SCRIPT_PATH=

# Frontend (apps/web) — Next.js chi doc bien co tien to NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=http://localhost:8000

# Hai tai khoan test cho BGK tu thu (Must M6). Mat khau KHONG ghi o day,
# dat trong .env that hoac trong secret cua nha cung cap.
DEMO_USER_EMAIL=
DEMO_OPS_EMAIL=

# Could (khong lam vong nay) — che do nguoi than ban rut gon dung link chia se,
# khong dung bot. Xem docs/DECISIONS.md 2026-11-24.
TELEGRAM_BOT_TOKEN=
